    SCOPE --> E["EkoH/Smart Vote schema\nkx_e_<world>_r<release>"]
    SCOPE --> G["Global auth/control tables"]
    RT --> CACHE["Redis namespaced"]
    RT --> TASK["Celery WorldTask"]
    RT --> SEARCH["Search / embeddings namespace"]
    RT --> WS["WebSocket namespace"]
    RT --> MEDIA["World media namespace"]

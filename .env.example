# Konnaxion Worlds standalone configuration
KONNAXION_WORLDS_DATABASE_URL=
# Example:
# KONNAXION_WORLDS_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
KONNAXION_WORLDS_SECRET_KEY=change-me
KONNAXION_WORLDS_DEBUG=true
KONNAXION_WORLDS_ALLOWED_HOSTS=127.0.0.1,localhost
# REDIS_URL=redis://127.0.0.1:6379/0

# Fail closed for unscoped data-plane API routes.
KONNAXION_WORLDS_ENFORCE_SCOPED_API=true

# World build queue (raise carefully; 2 is a good local starting point)
KONNAXION_WORLD_BUILD_CONCURRENCY=2
KONNAXION_WORLD_BUILD_RETRY_SECONDS=5

# Optional: point the standalone manager at host-owned seed-data.
# KONNAXION_WORLD_SEED_ROOT=C:\mycode\Konnaxion\Konnaxion\backend\seed-data\worlds
# KONNAXION_UNIVERSE_SEED_ROOT=C:\mycode\Konnaxion\Konnaxion\backend\seed-data\universes

# Storage diagnostics / GC are available with:
#   python worlds_manage.py worlds_storage
#   python worlds_manage.py worlds_gc --failed
# Transaction-pooling PostgreSQL endpoints are supported by v0.3.2 migration scopes.

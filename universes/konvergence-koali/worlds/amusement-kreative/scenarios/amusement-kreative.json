      "title": "Vidéo au masque rouge — résonance texte/danse",
      "description": "Deux œuvres produites en parallèle semblent créer des correspondances lors de leur superposition. Étudier l’effet sans convertir l’intuition en certitude.",
      "status": "open",
      "category": "deliberation"
    },
    {
      "key": "two_dance_videos",
      "title": "Deux vidéos d’incarnation",
      "description": "Jérémie veut produire deux vidéos qui incarnent la figure Réjean/King Klown sous deux registres distincts.",
      "status": "open",
      "category": "project"
    }
  ],
  "stances": [],
  "arguments": [
    {
      "key": "arg_1",
      "topic": "red_mask_video",
      "actor": "actor_jeremie",
      "content": "La superposition semble faire apparaître une correspondance qui n’était intentionnelle dans aucune des deux œuvres prises séparément.",
      "side": "neutral"
    },
    {
      "key": "arg_2",
      "topic": "red_mask_video",
      "actor": "actor_elias",
      "content": "Hypothèse de travail : deux expressions issues d’un pattern commun peuvent résonner lorsqu’elles sont superposées; je nomme cela résonance de Pi.",
      "side": "neutral"
    },
    {
      "key": "arg_3",
      "topic": "red_mask_video",
      "actor": "actor_simon",
      "content": "Il faut comparer les correspondances et les non-correspondances, tester d’autres textes et préserver l’hypothèse de coïncidence.",
      "side": "neutral"
    },
    {
      "key": "arg_4",
      "topic": "red_mask_video",
      "actor": "actor_aida",
      "content": "La résonance peut être explorée comme interprétation; elle ne doit pas être présentée comme preuve métaphysique.",
      "side": "neutral"
    }
  ],

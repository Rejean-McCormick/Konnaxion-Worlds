  "topics": [
    {
      "key": "expression_platform_harms",
      "title": "[DEMO] How should online services address serious harms while protecting freedom of expression?",
      "description": "FLAGSHIP SIMULATION — no initial position is implied.\n\nContext: UNESCO’s Internet for Trust approach frames platform governance as human-rights-based, multistakeholder, transparent and accountable, with attention to systemic risks rather than only individual content removal.\n\nTrigger: A fictional regulator and major platforms must agree on a governance framework after evidence of harmful amplification and inconsistent moderation practices.\n\nDecision task: Define due-diligence duties, transparency, risk assessment, user redress, regulator independence, research access and emergency safeguards.\n\nCommon evidence baseline: Internet for Trust; Guidelines for the Governance of Digital Platforms; 2025 World Trends Report: Journalism — Shaping a World at Peace; Recommendation on the Ethics of Artificial Intelligence.\n\nStructured casting, evidence URLs, uncertainties, event injects, round plan and cross-World links are in the seed flagship source file.",
      "status": "open",
      "category": "freedom-expression"
    },
    {
      "key": "journalist_safety_accountability",
      "title": "[DEMO] Which accountability mechanisms best protect journalists facing threats and attacks?",
      "description": "FLAGSHIP SIMULATION — no initial position is implied.\n\nContext: UNESCO maintains global monitoring on killings of journalists and judicial follow-up, reports regularly on impunity, and documents national safety mechanisms and action plans.\n\nTrigger: A fictional country is designing or reforming a national safety mechanism after threats and attacks expose fragmented institutional responsibilities.\n\nDecision task: Agree on institutional roles, emergency protection, independent oversight, investigation follow-up, data/reporting and safeguards against misuse.\n\nCommon evidence baseline: Observatory of Killed Journalists; Director-General's Report on the Safety of Journalists and the Danger of Impunity; Global trends and recommendations for strengthening National Safety Mechanisms for Journalists; 2025 World Trends Report: Journalism — Shaping a World at Peace.\n\nStructured casting, evidence URLs, uncertainties, event injects, round plan and cross-World links are in the seed flagship source file.",
      "status": "open",
      "category": "journalism"
    },
    {
      "key": "media_literacy_synthetic_media",
      "title": "[DEMO] How should media and information literacy adapt to synthetic media and generative AI?",
      "description": "Compare journalism, education, technology, psychology, social context and ethics.",
      "status": "open",
      "category": "media-literacy"
    },

{
  "schemaVersion": 1,
  "productId": "konnaxion",
  "owner": "Konnaxion",
  "variables": {
    "webPort": {
      "type": "port",
      "env": "KOALI_KONNAXION_PORT",
      "default": 4301
    },
    "apiPort": {
      "type": "port",
      "env": "KOALI_KONNAXION_BACKEND_PORT",
      "default": 8301
    }
  },
  "surface": {
    "embedBase": "http://127.0.0.1:${webPort}"
  },
  "processes": [
    {
      "id": "api",
      "cwd": ".",
      "command": {
        "win32": "pwsh.exe",
        "default": "pwsh"
      },
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "koali/start-api.ps1",
        "-Port",
        "${apiPort}"
      ],
      "probeId": "api"
    },
    {
      "id": "web",
      "cwd": "frontend",
      "command": "pnpm",
      "shell": {
        "win32": true,
        "default": false
      },
      "args": [
        "exec",
        "next",
        "dev",
        "--turbo",
        "--hostname",
        "127.0.0.1",
        "--port",
        "${webPort}"
      ],
      "env": {
        "PORT": "${webPort}",
        "NEXT_PUBLIC_API_BASE": "http://127.0.0.1:${apiPort}/api",
        "NEXT_PUBLIC_BACKEND_BASE": "http://127.0.0.1:${apiPort}",
        "NEXT_PUBLIC_KONNAXION_API_ORIGIN": "http://127.0.0.1:${apiPort}",
        "API_PROXY_BASE": "http://127.0.0.1:${apiPort}/api"
      },
      "probeId": "web"
    }
  ],
  "probes": [
    {
      "id": "api",
      "url": "http://127.0.0.1:${apiPort}/health/ready/",
      "required": true,
      "statuses": [
        200
      ],
      "timeoutMs": 2500
    },
    {
      "id": "web",
      "url": "http://127.0.0.1:${webPort}/",
      "required": true,
      "statuses": [
        200,
        307,
        308
      ],
      "timeoutMs": 2500
    }
  ]
}

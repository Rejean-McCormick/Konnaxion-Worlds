##############################################################################
# Konnaxion code-snapshot exclusions ONLY
#
# These files may legitimately remain versioned in Git, but are usually noise
# for an AI/code-review snapshot. Secrets and reproducible local artifacts belong
# in .gitignore instead of here.
##############################################################################

##############################################################################
# 1) Dependency lockfiles
# Keep in Git for reproducible builds; omit from code snapshots.
##############################################################################
pnpm-lock.yaml
package-lock.json
yarn.lock
uv.lock

##############################################################################
# 2) Large/static versioned assets
##############################################################################
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.ico
*.mp4
*.webm
*.mov
*.avi
*.pdf
*.docx
*.xlsx
*.crt

##############################################################################
# 3) Versioned data / inventories not needed for source review
##############################################################################
seed-data/
EndPoints-Graphs/

backend/routes.json
backend/routes.csv
frontend/routes.json
frontend/frontend_endpoints.json
frontend/frontend_endpoints.csv

schema-endpoints.json
combined_manifest.yml
manifest_*.yml

# Repository inventories / path snapshots
OVERLAY_TREE.txt
**/pathbackend_*.txt

##############################################################################
# 4) Project status / scenario documentation
# Keep technical reference docs and source-facing READMEs in the snapshot.
##############################################################################
docs/status/
docs/demo-scenarios/

